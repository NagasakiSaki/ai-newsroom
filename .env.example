# Safe first launch: fictional demo, no model or WeChat calls.
DEMO_MODE=true
DATA_DIR=data
# Leave blank to generate a local login token in data/admin-token.txt.
ADMIN_TOKEN=

# Real mode: configure models in the settings page, or fill these fields.
# Use the provider's Chat Completions base URL, not /chat/completions itself.
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL=
PROMPT_BASE_URL=
PROMPT_API_KEY=
PROMPT_MODEL=
REVIEW_BASE_URL=
REVIEW_API_KEY=
REVIEW_MODEL=
VISUAL_BASE_URL=
VISUAL_API_KEY=
VISUAL_MODEL=
LLM_JSON_MODE=true
FAST_MODE=true
EDITORIAL_MODE=auto
REVIEW_MODE=off
# An optional extra writer call. Disabled here to reduce default costs.
POLISH_PASS=false
LLM_MAX_OUTPUT_TOKENS=0
MAX_MODEL_CALLS_PER_RUN=0
MAX_DRAFTS_PER_DAY=0
MAX_DRAFTS_PER_RUN=0
MAX_CANDIDATES_PER_RUN=12

# Off for new installations. Enable deliberately from the schedule page.
SCHEDULER_ENABLED=false
SCHEDULE_TIMES=09:00,18:00
COLLECT_INTERVAL_MINUTES=30
SOURCE_POLL_MINUTES=15

DELIVERY_MODE=local
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_THUMB_MEDIA_ID=
WECHAT_COVER_PATH=
WECHAT_AUTHOR=AI 编辑部

# Optional local HTTP/mixed proxy, for example http://127.0.0.1:7897.
NEWS_PROXY_URL=
LLM_PROXY_URL=
PROMPT_PROXY_URL=
REVIEW_PROXY_URL=
VISUAL_PROXY_URL=
# Image provider, endpoint and credentials are configured in the UI.
